rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /beer-labels/{file=**} {
      // Imagens dos rótulos são públicas (são exibidas no painel de TV).
      allow read: if true;

      // Somente usuários autenticados podem enviar/remover imagens.
      allow write: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
